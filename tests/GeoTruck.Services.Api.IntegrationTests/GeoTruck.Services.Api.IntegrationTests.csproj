<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeoTruck.Services.Api\GeoTruck.Services.Api.csproj" />
  </ItemGroup>

  <!-- Os testes montam o banco com os mesmos scripts do Liquibase. -->
  <ItemGroup>
    <Content Include="..\..\database\changelogs\**\*" LinkBase="changelogs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
